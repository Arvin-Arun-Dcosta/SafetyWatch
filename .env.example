# Copy this file to .env.local and fill in the values.
# The app refuses to start while a required variable is missing.

# --- Site URL (optional) ----------------------------------------------------
# Public URL of the site, without a trailing slash. Used for metadata,
# robots.txt, the sitemap and as the auth base URL. Defaults to
# https://safetywatch.arvin.life in production and http://localhost:3000 in development.
# Read at build time: redeploy after changing it.
NEXT_PUBLIC_SITE_URL=

# --- Database (required) ----------------------------------------------------
# PostgreSQL connection string (postgresql://...). On Neon use the pooled URL
# (host contains "-pooler") and write sslmode=verify-full instead of
# sslmode=require, which the pg driver warns about.
DATABASE_URL=
# Optional. Direct (non-pooled) Neon URL, used only by the Prisma CLI for
# migrations. Falls back to DATABASE_URL when unset (fine for local Postgres).
DATABASE_URL_UNPOOLED=

# --- Auth (required) --------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional. Overrides the auth base URL; defaults to NEXT_PUBLIC_SITE_URL.
BETTER_AUTH_URL=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: <site URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gemini (required) ------------------------------------------------------
# Server-side key for "Extract Details from Image".
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# --- Vercel Blob (required) -------------------------------------------------
# Read-write token of a PRIVATE Blob store (Vercel > Storage > Blob).
BLOB_READ_WRITE_TOKEN=

# --- App settings (optional) ------------------------------------------------
# IANA time zone used to enter and display incident times and for the
# "by hour" statistics. Defaults to Asia/Kolkata.
APP_TIME_ZONE=

# --- Seed script only (npm run db:seed) -------------------------------------
# The account that becomes the admin.
ADMIN_EMAIL=
# Optional, at least 12 characters. Gives the admin a password login. Leave
# empty to have the admin sign in with Google using ADMIN_EMAIL.
ADMIN_PASSWORD=
